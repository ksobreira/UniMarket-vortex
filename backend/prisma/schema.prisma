generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  BOOKS
  STUDY_MATERIALS
  ELECTRONICS
  EQUIPMENT
  FURNITURE
  CLOTHING
  ACCESSORIES
  OTHER
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  avatar    String?

  listings  Listing[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Listing {
  id          String   @id @default(uuid())
  title       String
  description String
  price       Decimal?
  isDonation  Boolean  @default(false)
  imageUrl    String
  category    Category

  sellerId    String
  seller      User     @relation(fields: [sellerId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}